# Temp/Build files
tmp/*
!tmp/.touch
# Build output from the assets pipeline lands in static/public, but the
# checked-in brand images and fonts must stay in the repo. Git will not
# descend into an excluded directory, so the negations need trailing
# slashes on the directories themselves, not globs on their contents.
mytemplate/static/public/*
!mytemplate/static/public/images/
!mytemplate/static/public/mytemplate/
!mytemplate/static/public/fonts/
artifacts/
test-reports/
